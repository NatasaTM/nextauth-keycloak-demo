# ============================================
# NextAuth + Keycloak Example Environment File
# ============================================

# Base URL of your Next.js app.
# In development this is usually http://localhost:3000
# In production, set this to your deployed domain (e.g. https://myapp.com)
NEXTAUTH_URL=http://localhost:3000

# A long, random string used to sign/encrypt cookies and JWTs.
# ⚠️ Do NOT commit a real secret to Git.
# Generate one and paste it here:
#
# On Linux / Mac:
#   openssl rand -base64 32
#
# On Windows PowerShell:
#   [System.Convert]::ToBase64String((1..32 | ForEach-Object {Get-Random -Maximum 256}))
NEXTAUTH_SECRET=replace-with-a-long-random-string

# --------------------------------------------
# Keycloak provider settings
# --------------------------------------------

# The issuer URL of your Keycloak realm.
# Format: http(s)://<host>/realms/<realm-name>
# Example if Keycloak runs locally:
#   http://localhost:8080/realms/demo
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/demo

# The client ID of your Keycloak client (created inside the realm).
AUTH_KEYCLOAK_ID=replace-with-your-client-id

# The client secret of your Keycloak client (found under:
# Keycloak Admin Console → Clients → <your-client> → Credentials tab).
# ⚠️ Keep this safe, never commit a real secret.
AUTH_KEYCLOAK_SECRET=replace-with-your-client-secret
